# Keep challenge binaries byte-for-byte: no line-ending conversion.
*.pdf    binary
*.pcapng binary
*.bin    binary
*.png    binary
*.zip    binary

# Normalize text to LF in the repo (served fine by Pages on any OS).
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
